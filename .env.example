# ---- AI provider ----
# "anthropic" | "deepseek"
# NOTE: DeepSeek's Anthropic-compatible endpoint does NOT support MCP tool
# orchestration (mcp_servers) or image input as of this writing. If you pick
# "deepseek", the drafting/fit-scoring calls will work, but any workflow that
# needs Claude to call into Gmail/Outlook/Calendar/Drive MCP servers directly
# from the same request must stay on "anthropic", or you handle tool-calling
# yourself. See lib/ai-provider.ts.
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# Only used when AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# ---- Mail / calendar / drive provider ----
# "google" | "microsoft"
MAIL_PROVIDER=google

# Google OAuth (Gmail, Calendar, Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MCP_URL=

# Microsoft OAuth (Outlook Mail, Calendar, OneDrive via Graph API)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
OUTLOOK_MCP_URL=

# ---- Core data / infra ----
SAM_GOV_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@yourdomain.com
# Vercel Cron sends this automatically as `Authorization: Bearer $CRON_SECRET`
# once set — protects app/api/cron/poll-sam-gov from being called publicly.
CRON_SECRET=

# ---- Dev-time UI tooling (used only inside Claude Code / Cursor, never at runtime) ----
# Add these to your MCP client config (e.g. Claude Code's mcp settings), NOT here.
# 21st.dev Magic MCP: https://21st.dev  (rotate any key you've already shared)
# ui-ux-pro-max skill: https://github.com/nextlevelbuilder/ui-ux-pro-max-skill
